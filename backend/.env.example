# --- AI (OpenRouter only) ---
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=StripeFit
MODEL_VISION=anthropic/claude-haiku-5.5
MODEL_VISION_FALLBACKS=google/gemini-3.1-flash-lite,openai/gpt-4.1-mini
MODEL_FAST=google/gemini-2.5-flash-lite
MODEL_FAST_FALLBACKS=anthropic/claude-haiku-5.5,openai/gpt-4.1-nano
MODEL_STYLIST=anthropic/claude-sonnet-5.5
MODEL_STYLIST_FALLBACKS=openai/gpt-4.1,google/gemini-2.5-flash
USE_MOCK_AI=true
AI_TIMEOUT_SECONDS=45
AI_REASONING=off

# --- Stripe (test mode only) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
FRONTEND_URL=http://localhost:5173

# --- Gmail (read-only OAuth, testing mode) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# --- Defaults ---
DEFAULT_LOCATION_NAME=Dublin
DEFAULT_LAT=53.3498
DEFAULT_LON=-6.2603
TIMEZONE=Europe/Dublin
FREE_ITEM_LIMIT=20
# --- Daily casual fit notifications (Web Push). Fill in with: python scripts/make_vapid_keys.py ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:stripefit-demo@example.com
DAILY_SCHEDULER_ENABLED=true

DEMO_CONTROLS=true
